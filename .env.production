# Production environment for `vite build`.
#
# Vite reads this file automatically when NODE_ENV=production (which `vite
# build` sets). Anything prefixed VITE_ is inlined into the built bundle.
#
# Update VITE_API_BASE_URL with your actual Render backend URL after the
# first deploy succeeds — the URL is shown in the Render dashboard under
# the service name (typically https://<service-name>.onrender.com).

VITE_APP_RELEASE_VERSION="RELEASE-PROD"
VITE_API_BASE_URL="https://dream-support-backend.onrender.com/api"
